COMPOSE_PROJECT_NAME=war-archive
TZ=Asia/Seoul
ADMIN_PORT=9231
WAR_ARCHIVE_ADMIN_TOKEN=replace-with-admin-token

COLLECTION_INTERVAL_MS=600000
PROCESSING_DELAY_MS=600000
