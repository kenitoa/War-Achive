{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src",
    "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"], "exclude": ["dist", "node_modules"]
}
